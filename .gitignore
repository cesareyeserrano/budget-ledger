# Dependencies
node_modules/
.npm
vendor/
.venv/
__pycache__/
*.pyc

# Environment variables
.env
# Cualquier variante (.env.local, .env.production, .env.staging…) salvo la plantilla. Antes solo
# estaban .env, .env.local y .env.*.local: un .env.production con valores reales se podía commitear.
.env.*
!.env.example

# Build output
dist/
build/
out/
*.egg-info/

# Next.js
.next/
next-env.d.ts
*.tsbuildinfo

# Test / e2e output
test-results/
playwright-report/

# Logs
logs/
*.log

# Runtime
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# Claude Code — worktrees de tareas en background (por máquina; .claude/launch.json SÍ se versiona)
.claude/worktrees/

# Aitri — per-machine state (the shared .aitri IS committed)
.aitri.local
.aitri.lock
.next-smoke/
.next-e2e/
aitri/features/INDEX.md

# Directorios de build efímeros por NEXT_DIST_DIR (smoke, e2e, sec, buildcheck)
.next-*/
