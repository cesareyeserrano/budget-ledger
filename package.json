{
  "name": "t-ledger",
  "version": "0.0.1-beta",
  "private": true,
  "description": "Ledger — app web de finanzas personales contra presupuesto (single-user, localStorage v1)",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "dev:lan": "next dev -H 0.0.0.0 -p 3100",
    "db:up": "docker compose -f docker-compose.dev.yml up -d db db-viewer",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "mail:up": "docker compose -f docker-compose.dev.yml up -d mail",
    "mail:down": "docker compose -f docker-compose.dev.yml stop mail",
    "db:migrate": "DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger node scripts/migrate.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern '.next-*/**' --ignore-pattern '.claude/worktrees/**'",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "coverage": "AITRI_COVERAGE=1 vitest run --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "gate:design-tokens": "./scripts/design-tokens.sh",
    "gate:security-config": "./scripts/security-config.sh",
    "gate:secret-scan": "./scripts/secret-scan.sh",
    "gate:smoke": "./smoke.sh",
    "test:e2e": "./e2e.sh",
    "test:e2e:backend": "playwright test --config playwright.backend.config.ts",
    "test:backend:full": "./backend-full.sh",
    "user:reset-password": "node scripts/reset-password.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@node-rs/argon2": "^2.2.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^0.474.0",
    "next": "^15.1.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.0.0",
    "testcontainers": "^12.0.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "$postcss",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.6"
  }
}
